    {
        "id": "d290d116119122ae",
        "type": "function",
        "z": "64f44b0e1e2a2ec5",
        "name": "Simpan Threshold",
        "func": "const threshold = Number(msg.payload.threshold);\n\nif (!Number.isFinite(threshold) || threshold < 0 || threshold > 100) {\n    msg.statusCode = 400;\n    msg.payload = {\n        status: \"error\",\n        message: \"Threshold harus berupa angka 0-100\"\n    };\n    return msg;\n}\n\nflow.set(\"threshold\", threshold);\n\nmsg.statusCode = 200;\nmsg.headers = {\n    \"Access-Control-Allow-Origin\": \"*\",\n    \"Content-Type\": \"application/json\"\n};\n\nmsg.payload = {\n    status: \"success\",\n    message: \"Batas suhu berhasil diubah\",\n    threshold: threshold\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 670,
        "y": 1420,
        "wires": [
            [
                "c14d54b5e9b8feb6"
            ]
        ]
    },
    {
        "id": "771e5a2d58e93e64",
        "type": "function",
        "z": "64f44b0e1e2a2ec5",
        "name": "Cek Threshold",
        "func": "const data = msg.payload;\n\nconst suhu = Number(data.suhu);\nconst threshold = Number(flow.get(\"threshold\") ?? 30);\n\nconst sebelumnyaDiAtas = flow.get(\"wasAbove\") === true;\nconst sekarangDiAtas = suhu > threshold;\n\nif (sekarangDiAtas && !sebelumnyaDiAtas) {\n    flow.set(\"wasAbove\", true);\n\n    msg.payload = {\n        type: \"alert\",\n        status: \"warning\",\n        message: \"PERINGATAN! Suhu melewati batas!\",\n        suhu: suhu,\n        threshold: threshold,\n        timestamp: data.timestamp\n    };\n\n    return msg;\n}\n\nif (!sekarangDiAtas) {\n    flow.set(\"wasAbove\", false);\n}\n\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 540,
        "y": 920,
        "wires": [
