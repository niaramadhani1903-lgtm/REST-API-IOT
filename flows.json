        "func": "const API_KEY = \"NIA_IOT_2026\";\n\nconst key = msg.req.headers[\"x-api-key\"];\n\nif (key === API_KEY) {\n    return [msg, null];\n}\n\n// Jika API Key salah\nmsg.statusCode = 401;\n\nmsg.headers = {\n    \"Access-Control-Allow-Origin\": \"*\",\n    \"Content-Type\": \"application/json\"\n};\n\nmsg.payload = {\n    status: \"error\",\n    message: \"API Key tidak valid atau tidak ditemukan\"\n};\n\nreturn [null, msg];",
